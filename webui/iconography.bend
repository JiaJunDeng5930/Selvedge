def drawing_paint(value: Controls.IconPaint) -> Source.DrawingPaint:
  match value:
    case Controls.FilledIcon{}: Source.FilledDrawing{}
    case Controls.StrokedIcon{}: Source.StrokedDrawing{14n}

def drawing(+icon: Controls.Icon, +size: Nat) -> Source.Drawing:
  Source.Drawing{"0 0 20 20", [Source.DrawingPath{path(icon)}], size, size, drawing_paint(Controls.icon_paint(icon))}
