
(* The JS wrapper retains the token. Only this runtime can read the extracted context. *)
let contexts : Js.Unsafe.any = Js.Unsafe.new_obj (Js.Unsafe.pure_js_expr "WeakMap") [||]

let retain context : Js.Unsafe.any =
  let token = Js.Unsafe.obj [||] in
  ignore (Js.Unsafe.meth_call contexts "set" [| Js.Unsafe.inject token; Js.Unsafe.inject context |]);
  token

let structured source number_text =
  Json.of_js_exn source ~number_text:(fun value -> Js.Unsafe.fun_call number_text [| value |])

let prepare source number_text =
  Js.Opt.option (Option.map retain (Model.selvedge_interaction_prepare (structured source number_text)))

let context_for token =
  match Js.Optdef.to_option (Js.Unsafe.meth_call contexts "get" [| Js.Unsafe.inject token |]) with
  (* DEFENSE: The exported entry can be called without an issued context token. *)
  | None -> Json.raise_input_exn "TypeError" "Invalid prepared interaction context"
  | Some context -> context

let rebase source token number_text =
  let context = context_for token in
  Js.Opt.option (Option.map retain
    (Model.selvedge_interaction_rebase (structured source number_text) context))

let prepared_call operation source token number_text number =
  let context = context_for token in
  let value, next = Model.selvedge_interaction_prepared_call
    (Js.to_string operation) (structured source number_text) context in
  let next_token = if context == next then token else retain next in
  Js.array [| to_js number value; Js.Unsafe.inject next_token |]

let publish_native project source token number ops =
  let context = context_for token in
  Js.Opt.option (Option.map (native_nodes number ops) (project (Json.parse (Js.to_string source)) context))

let publish_prepared project source token number ops =
  let context = context_for token in
  match project (Json.parse (Js.to_string source)) context with
  | None -> Js.Opt.empty
  | Some (presentation, next) ->
      let output = native_nodes number ops presentation in
      Js.Unsafe.set output "token" (if context == next then token else retain next);
      Js.Opt.return output

let () =
  let runtime = Js.Unsafe.get Js.Unsafe.global "@GLOBAL@" in
  Js.Unsafe.set runtime "prepare" (Js.wrap_callback prepare);
  Js.Unsafe.set runtime "rebase" (Js.wrap_callback rebase);
  Js.Unsafe.set runtime "preparedCall" (Js.wrap_callback prepared_call);
  Js.Unsafe.set runtime "publishNativeDocument" (Js.wrap_callback (publish_prepared Model.selvedge_interaction_native_document));
  Js.Unsafe.set runtime "publishNativeRegion" (Js.wrap_callback (publish_prepared Model.selvedge_interaction_native_region));
  Js.Unsafe.set runtime "publishNativePicker" (Js.wrap_callback (publish_prepared Model.selvedge_interaction_native_picker));
  Js.Unsafe.set runtime "publishNativeStream" (Js.wrap_callback (publish_native Model.selvedge_interaction_native_stream))
